/* =========================================================
   文化祭 SPECIAL
   FREE SCHOOL FESTIVAL VOTE
   ========================================================= */

:root {
  --green-950: #06382b;
  --green-900: #07513d;
  --green-800: #09664c;
  --green-700: #0b7658;
  --green-600: #15916b;
  --gold-700: #a87816;
  --gold-600: #c89422;
  --gold-500: #e2b84b;
  --cream: #f8f5eb;
  --cream-2: #f1eee3;
  --white: #ffffff;
  --ink: #17251f;
  --muted: #6c766f;
  --line: #dfe5df;
  --danger: #b53b35;
  --shadow: 0 18px 45px rgba(6, 56, 43, 0.10);
  --radius: 22px;
}

* {
  box-sizing: border-box;
}

html {
  scroll-behavior: smooth;
}

body {
  margin: 0;
  min-height: 100vh;
  background:
    radial-gradient(circle at 10% 0%, rgba(226,184,75,.16), transparent 30%),
    linear-gradient(180deg, #f7f8f4 0%, #eef2ed 100%);
  color: var(--ink);
  font-family:
    "Noto Sans JP",
    -apple-system,
    BlinkMacSystemFont,
    "Hiragino Kaku Gothic ProN",
    "Yu Gothic",
    sans-serif;
}

button,
input,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

button:disabled {
  cursor: not-allowed;
  opacity: .55;
}

a {
  color: inherit;
  text-decoration: none;
}


/* =========================================================
   SHELL
   ========================================================= */

.app-shell {
  width: 100%;
  min-height: 100vh;
}


/* =========================================================
   HEADER
   ========================================================= */

.site-header {
  position: sticky;
  top: 0;
  z-index: 100;
  background: rgba(6, 56, 43, .97);
  color: white;
  box-shadow: 0 5px 25px rgba(0,0,0,.14);
  backdrop-filter: blur(12px);
}

.header-inner {
  width: min(1180px, calc(100% - 36px));
  margin: auto;
  min-height: 82px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.brand {
  display: flex;
  align-items: center;
  gap: 13px;
}

.brand-mark {
  width: 47px;
  height: 47px;
  display: grid;
  place-items: center;
  border: 1px solid rgba(226,184,75,.7);
  border-radius: 50%;
  color: var(--gold-500);
  font-size: 27px;
  background: rgba(255,255,255,.05);
  box-shadow: inset 0 0 0 4px rgba(255,255,255,.025);
}

.brand-text {
  display: flex;
  flex-direction: column;
  line-height: 1.1;
}

.brand-text strong {
  font-size: 18px;
  letter-spacing: .08em;
}

.brand-text small {
  margin-top: 5px;
  color: #d9e5df;
  font-size: 10px;
  font-weight: 700;
  letter-spacing: .24em;
}

.header-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.free-badge {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 7px 11px;
  border: 1px solid rgba(226,184,75,.65);
  border-radius: 999px;
  color: #ffe7a2;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .06em;
}

.icon-button {
  width: 38px;
  height: 38px;
  border: 1px solid rgba(255,255,255,.2);
  border-radius: 50%;
  background: rgba(255,255,255,.07);
  color: white;
  font-size: 19px;
}

.main-nav {
  width: min(1180px, calc(100% - 36px));
  margin: auto;
  display: flex;
  gap: 3px;
  overflow-x: auto;
}

.nav-link {
  position: relative;
  padding: 13px 21px 15px;
  border: 0;
  background: transparent;
  color: #bfd0c9;
  font-size: 13px;
  font-weight: 800;
  white-space: nowrap;
}

.nav-link:hover {
  color: white;
}

.nav-link.active {
  color: white;
}

.nav-link.active::after {
  content: "";
  position: absolute;
  left: 18px;
  right: 18px;
  bottom: 0;
  height: 3px;
  border-radius: 3px 3px 0 0;
  background: var(--gold-500);
}

.admin-nav {
  margin-left: auto;
}


/* =========================================================
   MAIN
   ========================================================= */

main {
  width: min(1180px, calc(100% - 36px));
  margin: auto;
  padding: 46px 0 80px;
}

.view {
  display: none;
}

.view.active-view {
  display: block;
}


/* =========================================================
   HERO
   ========================================================= */

.hero-grid {
  position: relative;
  min-height: 390px;
  display: grid;
  grid-template-columns: 1.05fr .95fr;
  align-items: center;
  overflow: hidden;
  border-radius: 30px;
  background:
    linear-gradient(135deg, #064b39 0%, #087255 55%, #0d805f 100%);
  color: white;
  box-shadow: 0 25px 65px rgba(6,56,43,.22);
}

.hero-grid::before {
  content: "";
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255,255,255,.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255,255,255,.035) 1px, transparent 1px);
  background-size: 32px 32px;
  pointer-events: none;
}

.hero-copy {
  position: relative;
  z-index: 3;
  padding: 58px 50px;
}

.eyebrow {
  display: flex;
  align-items: center;
  gap: 8px;
  margin: 0 0 15px;
  color: var(--gold-500);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .2em;
}

.eyebrow-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: var(--gold-500);
  box-shadow: 0 0 0 5px rgba(226,184,75,.13);
}

.hero-copy h1 {
  margin: 0;
  font-size: clamp(42px, 5vw, 70px);
  line-height: 1.08;
  letter-spacing: -.045em;
  font-weight: 900;
}

.hero-copy h1 em {
  color: #ffe49a;
  font-style: normal;
}

.hero-description {
  margin: 25px 0 0;
  color: #dbe9e3;
  line-height: 1.9;
  font-size: 14px;
}

.hero-notes {
  display: flex;
  flex-wrap: wrap;
  gap: 9px;
  margin-top: 26px;
}

.hero-notes span {
  padding: 7px 11px;
  border: 1px solid rgba(255,255,255,.16);
  border-radius: 999px;
  background: rgba(255,255,255,.07);
  color: #f3f8f5;
  font-size: 11px;
  font-weight: 700;
}

.hero-notes span span {
  padding: 0;
  border: 0;
  background: transparent;
  color: var(--gold-500);
}


/* =========================================================
   HERO ILLUSTRATION
   ========================================================= */

.horse-illustration {
  position: absolute;
  inset: 0 0 0 50%;
  overflow: hidden;
}

.sun {
  position: absolute;
  top: 48px;
  right: 85px;
  width: 100px;
  height: 100px;
  border-radius: 50%;
  background: rgba(226,184,75,.75);
  box-shadow: 0 0 70px rgba(226,184,75,.28);
}

.hill {
  position: absolute;
  bottom: -100px;
  border-radius: 50% 50% 0 0;
  transform: rotate(-7deg);
}

.hill-back {
  left: -30px;
  width: 600px;
  height: 220px;
  background: rgba(255,255,255,.08);
}

.hill-front {
  left: 80px;
  width: 620px;
  height: 190px;
  background: rgba(3,54,40,.42);
}

.illustrated-horse {
  position: absolute;
  right: 110px;
  bottom: 68px;
  font-size: 170px;
  line-height: 1;
  color: rgba(255,255,255,.9);
  filter: drop-shadow(8px 14px 0 rgba(3,40,30,.2));
  transform: rotate(-3deg);
}

.finish-flag {
  position: absolute;
  right: 0;
  top: 22px;
  width: 90px;
  height: 90px;
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  transform: rotate(7deg);
}

.finish-flag i {
  background: white;
}

.finish-flag i:nth-child(2n) {
  background: #0a5b45;
}


/* =========================================================
   CARDS
   ========================================================= */

.card {
  border: 1px solid var(--line);
  border-radius: var(--radius);
  background: rgba(255,255,255,.96);
  box-shadow: var(--shadow);
}


/* =========================================================
   RACE META
   ========================================================= */

.race-meta-card {
  margin-top: 20px;
  padding: 20px 24px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20px;
}

.race-meta-main {
  display: flex;
  align-items: center;
  gap: 20px;
}

.race-number {
  padding-right: 20px;
  border-right: 1px solid var(--line);
  color: var(--muted);
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .13em;
}

.race-number strong {
  display: block;
  margin-top: 3px;
  color: var(--green-800);
  font-size: 26px;
  letter-spacing: 0;
}

.race-meta-card h2 {
  margin: 0;
  font-size: 18px;
}

.race-meta-card p {
  margin: 5px 0 0;
  color: var(--muted);
  font-size: 11px;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  padding: 9px 13px;
  border-radius: 999px;
  background: #e7f6ef;
  color: var(--green-800);
  font-size: 11px;
  font-weight: 900;
  white-space: nowrap;
}

.status-dot,
.live-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #16a66f;
  box-shadow: 0 0 0 5px rgba(22,166,111,.12);
}


/* =========================================================
   NOTICE
   ========================================================= */

.notice-area {
  margin: 18px 0;
}

.notice-area:empty {
  display: none;
}


/* =========================================================
   VOTE LAYOUT
   ========================================================= */

.vote-layout {
  display: grid;
  grid-template-columns: minmax(0, 1.45fr) minmax(280px, .55fr);
  gap: 20px;
  margin-top: 20px;
}

.selection-card {
  padding: 30px;
}

.section-heading {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 15px;
  margin-bottom: 24px;
}

.section-kicker {
  margin: 0 0 6px;
  color: var(--green-700);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .2em;
}

.section-heading h2,
.admin-card h2 {
  margin: 0;
  font-size: 22px;
  letter-spacing: -.02em;
}

.count-label {
  color: var(--muted);
  font-size: 12px;
  font-weight: 700;
}

.count-label strong {
  color: var(--green-800);
  font-size: 21px;
}


/* =========================================================
   HORSE LIST
   ========================================================= */

.horse-list {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.horse-option {
  position: relative;
}

.horse-option input {
  position: absolute;
  opacity: 0;
  pointer-events: none;
}

.horse-option label {
  min-height: 91px;
  display: flex;
  align-items: center;
  gap: 14px;
  padding: 16px;
  border: 2px solid #e4e9e5;
  border-radius: 17px;
  background: #fbfcfa;
  transition: .18s ease;
  cursor: pointer;
}

.horse-option label:hover {
  border-color: #9fc9b8;
  transform: translateY(-2px);
  box-shadow: 0 10px 25px rgba(6,56,43,.08);
}

.horse-option input:checked + label {
  border-color: var(--green-700);
  background: #eef8f3;
  box-shadow: 0 0 0 3px rgba(11,118,88,.08);
}

.horse-number {
  width: 38px;
  height: 38px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: var(--green-900);
  color: white;
  font-size: 12px;
  font-weight: 900;
}

.horse-name {
  min-width: 0;
  font-size: 15px;
  font-weight: 900;
}

.horse-check {
  margin-left: auto;
  width: 23px;
  height: 23px;
  display: grid;
  place-items: center;
  border: 2px solid #ccd6d0;
  border-radius: 50%;
  color: transparent;
  font-size: 12px;
  font-weight: 900;
}

.horse-option input:checked + label .horse-check {
  border-color: var(--green-700);
  background: var(--green-700);
  color: white;
}


/* =========================================================
   BUTTONS
   ========================================================= */

.primary-button,
.secondary-button,
.outline-button,
.danger-button {
  border-radius: 13px;
  min-height: 49px;
  border: 0;
  font-weight: 900;
  transition: .18s ease;
}

.primary-button {
  background: linear-gradient(135deg, var(--green-800), var(--green-600));
  color: white;
  box-shadow: 0 10px 22px rgba(9,102,76,.18);
}

.primary-button:hover {
  transform: translateY(-2px);
  box-shadow: 0 14px 27px rgba(9,102,76,.25);
}

.vote-button {
  width: 100%;
  margin-top: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 13px;
  font-size: 15px;
}

.button-arrow {
  font-size: 19px;
}

.secondary-button {
  padding: 0 19px;
  background: #edf6f1;
  color: var(--green-800);
}

.outline-button {
  width: 100%;
  margin-top: 9px;
  border: 1px solid var(--line);
  background: white;
  color: var(--green-800);
}

.danger-button {
  padding: 0 18px;
  background: #fff0ef;
  color: var(--danger);
}

.text-button {
  border: 0;
  background: transparent;
  color: var(--green-800);
  font-weight: 800;
}

.tiny-note {
  margin: 11px 0 0;
  text-align: center;
  color: var(--muted);
  font-size: 10px;
}


/* =========================================================
   SIDE CARD
   ========================================================= */

.side-card {
  padding: 30px 25px;
  background:
    linear-gradient(180deg, #073e30 0%, #075b43 100%);
  color: white;
  border-color: transparent;
}

.side-card-icon {
  width: 53px;
  height: 53px;
  display: grid;
  place-items: center;
  border-radius: 15px;
  background: rgba(226,184,75,.13);
  border: 1px solid rgba(226,184,75,.3);
  font-size: 25px;
}

.side-card h3 {
  margin: 20px 0 9px;
  font-size: 20px;
}

.side-card > p {
  margin: 0;
  color: #cbded7;
  font-size: 12px;
  line-height: 1.8;
}

.rule-list {
  margin-top: 26px;
}

.rule-list > div {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 13px 0;
  border-top: 1px solid rgba(255,255,255,.1);
}

.rule-list b {
  color: var(--gold-500);
  font-size: 10px;
}

.rule-list span {
  font-size: 11px;
  font-weight: 700;
}


/* =========================================================
   VOTED
   ========================================================= */

.voted-card {
  margin-top: 20px;
  padding: 45px 30px;
  text-align: center;
}

.success-icon {
  width: 66px;
  height: 66px;
  margin: 0 auto 17px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: #e6f6ee;
  color: var(--green-700);
  font-size: 27px;
  font-weight: 900;
}

.voted-card h2 {
  margin: 7px 0;
  font-size: 28px;
}

.voted-card p {
  color: var(--muted);
}

.voted-card strong {
  color: var(--green-800);
}

.voted-card .secondary-button {
  margin-top: 15px;
}


/* =========================================================
   RESULTS
   ========================================================= */

.page-heading {
  padding: 12px 4px 28px;
}

.page-heading h1 {
  margin: 0;
  font-size: 42px;
  letter-spacing: -.045em;
}

.page-heading > p:last-child {
  margin: 9px 0 0;
  color: var(--muted);
  font-size: 13px;
}

.results-summary {
  display: grid;
  grid-template-columns: 1fr auto 1fr auto;
  align-items: center;
  gap: 22px;
  padding: 21px 27px;
}

.summary-stat {
  display: flex;
  align-items: center;
  gap: 13px;
}

.summary-icon {
  font-size: 26px;
}

.summary-stat strong {
  display: block;
  color: var(--green-800);
  font-size: 26px;
  line-height: 1;
}

.summary-stat small {
  display: block;
  margin-top: 5px;
  color: var(--muted);
  font-size: 10px;
}

.summary-divider {
  width: 1px;
  height: 40px;
  background: var(--line);
}

.summary-live {
  display: flex;
  align-items: center;
  gap: 7px;
  color: var(--green-700);
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .1em;
}

.results-layout {
  display: grid;
  grid-template-columns: 1fr 330px;
  gap: 20px;
  margin-top: 20px;
}

.ranking-card {
  padding: 29px;
}

.ranking-heading {
  margin-bottom: 18px;
}

.updated-label {
  color: var(--muted);
  font-size: 10px;
}

.ranking-list {
  display: grid;
  gap: 9px;
}

.ranking-item {
  display: grid;
  grid-template-columns: 42px 1fr auto;
  align-items: center;
  gap: 13px;
  padding: 13px 14px;
  border: 1px solid #e7ebe8;
  border-radius: 14px;
  background: #fafbf9;
}

.ranking-position {
  width: 34px;
  height: 34px;
  display: grid;
  place-items: center;
  border-radius: 10px;
  background: #edf2ee;
  color: var(--green-800);
  font-size: 12px;
  font-weight: 900;
}

.ranking-item:first-child .ranking-position {
  background: #f7e8bc;
  color: #8a6310;
}

.ranking-name {
  font-size: 13px;
  font-weight: 900;
}

.ranking-bar-wrap {
  margin-top: 5px;
  height: 5px;
  overflow: hidden;
  border-radius: 99px;
  background: #e7ece8;
}

.ranking-bar {
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--green-700), var(--gold-500));
}

.ranking-votes {
  text-align: right;
  font-size: 12px;
  font-weight: 900;
}

.ranking-votes small {
  display: block;
  color: var(--muted);
  font-size: 9px;
  font-weight: 500;
}

.result-box {
  min-height: 250px;
  padding: 28px;
  background: linear-gradient(145deg, #073e30, #09684d);
  color: white;
  border-color: transparent;
}

.result-box h2 {
  margin: 10px 0;
}

.result-box p {
  color: #cfe0da;
  font-size: 12px;
  line-height: 1.8;
}


/* =========================================================
   ADMIN
   ========================================================= */

.admin-login {
  width: min(520px, 100%);
  margin: 40px auto;
  padding: 38px;
  text-align: center;
}

.login-emblem {
  width: 63px;
  height: 63px;
  margin: 0 auto 16px;
  display: grid;
  place-items: center;
  border-radius: 18px;
  background: #edf6f1;
  color: var(--green-800);
  font-size: 27px;
}

.admin-login h1 {
  margin: 7px 0;
  font-size: 30px;
}

.login-lead {
  margin: 0 auto 25px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.8;
}

.login-form {
  text-align: left;
}

.login-form label,
.settings-form label,
.winner-card label {
  display: block;
  color: #405149;
  font-size: 11px;
  font-weight: 900;
}

.login-form input,
.settings-form input,
.winner-card select {
  width: 100%;
  height: 48px;
  margin-top: 7px;
  padding: 0 13px;
  border: 1px solid #dce3de;
  border-radius: 11px;
  outline: none;
  background: #fbfcfa;
  color: var(--ink);
}

.login-form input:focus,
.settings-form input:focus,
.winner-card select:focus {
  border-color: var(--green-600);
  box-shadow: 0 0 0 3px rgba(21,145,107,.1);
}

.login-form label + label {
  margin-top: 14px;
}

.login-form .primary-button {
  width: 100%;
  margin-top: 12px;
}

.form-error {
  min-height: 17px;
  margin: 9px 0 0;
  color: var(--danger);
  font-size: 11px;
}

.login-help {
  margin: 19px 0 0;
  color: var(--muted);
  font-size: 10px;
  line-height: 1.7;
}


/* =========================================================
   ADMIN DASHBOARD
   ========================================================= */

.admin-topbar {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  margin-bottom: 23px;
}

.admin-topbar h1 {
  margin: 0;
  font-size: 38px;
  letter-spacing: -.04em;
}

.admin-grid {
  display: grid;
  grid-template-columns: minmax(0, 1fr) 330px;
  gap: 20px;
}

.admin-main-column,
.admin-side-column {
  display: grid;
  gap: 20px;
  align-content: start;
}

.admin-card {
  padding: 26px;
}

.admin-card-heading {
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 15px;
  margin-bottom: 21px;
}

.saved-label {
  color: var(--green-700);
  font-size: 10px;
  font-weight: 800;
}

.admin-caption {
  margin: -8px 0 18px;
  color: var(--muted);
  font-size: 11px;
  line-height: 1.7;
}

.settings-form {
  display: grid;
  gap: 18px;
}

.status-setting {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 15px;
  padding: 14px;
  border: 1px solid #e5eae6;
  border-radius: 13px;
  background: #fafbf9;
}

.field-label {
  display: block;
  font-size: 11px;
  font-weight: 900;
}

.status-setting small {
  color: var(--muted);
  font-size: 9px;
}

.toggle-switch {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 5px 9px 5px 5px;
  border: 0;
  border-radius: 99px;
  background: #d9e0dc;
  color: #59655f;
  font-size: 10px;
  font-weight: 900;
}

.toggle-switch span {
  width: 25px;
  height: 25px;
  border-radius: 50%;
  background: white;
  box-shadow: 0 2px 6px rgba(0,0,0,.13);
}

.toggle-switch[aria-checked="true"] {
  background: var(--green-700);
  color: white;
}

.toggle-switch[aria-checked="true"] span {
  transform: translateX(0);
}

.admin-horse-list {
  display: grid;
  gap: 8px;
}

.admin-horse-row {
  display: grid;
  grid-template-columns: 34px 1fr auto auto;
  align-items: center;
  gap: 8px;
  padding: 9px;
  border: 1px solid #e5eae6;
  border-radius: 12px;
}

.admin-horse-number {
  color: var(--green-800);
  font-size: 11px;
  font-weight: 900;
  text-align: center;
}

.admin-horse-row input {
  min-width: 0;
  height: 38px;
  padding: 0 10px;
  border: 1px solid #dfe5e1;
  border-radius: 9px;
}

.admin-horse-row button {
  width: 34px;
  height: 34px;
  border: 1px solid #dfe5e1;
  border-radius: 8px;
  background: white;
  color: var(--green-800);
  font-weight: 900;
}

.danger-card {
  border-color: #efd8d6;
}

.danger-card .section-kicker {
  color: var(--danger);
}

.winner-card select {
  margin-bottom: 12px;
}

.current-winner {
  min-height: 34px;
  margin: 8px 0;
  color: var(--green-800);
  font-size: 12px;
  font-weight: 900;
}

.announce-button {
  width: 100%;
  margin-top: 5px;
}

.stats-card h2 {
  margin-bottom: 16px;
}

.admin-stat-row {
  display: flex;
  justify-content: space-between;
  padding: 13px 0;
  border-top: 1px solid var(--line);
  font-size: 11px;
}

.admin-stat-row strong {
  color: var(--green-800);
}

.admin-tip {
  display: flex;
  gap: 10px;
  padding: 17px;
  border: 1px dashed #cbd9d2;
  border-radius: 14px;
  background: #f4f8f5;
  color: #53625b;
}

.admin-tip p {
  margin: 0;
  font-size: 10px;
  line-height: 1.7;
}

.admin-toast {
  margin-bottom: 15px;
}


/* =========================================================
   TOAST / HIDDEN
   ========================================================= */

.hidden {
  display: none !important;
}

.toast {
  position: fixed;
  left: 50%;
  bottom: 25px;
  z-index: 200;
  transform: translate(-50%, 20px);
  opacity: 0;
  pointer-events: none;
  max-width: min(90vw, 500px);
  padding: 12px 18px;
  border-radius: 12px;
  background: #17352b;
  color: white;
  box-shadow: 0 15px 40px rgba(0,0,0,.2);
  font-size: 12px;
  font-weight: 700;
  transition: .2s ease;
}

.toast.show {
  opacity: 1;
  transform: translate(-50%, 0);
}


/* =========================================================
   FOOTER
   ========================================================= */

.site-footer {
  width: min(1180px, calc(100% - 36px));
  margin: 0 auto;
  padding: 28px 0 45px;
  display: flex;
  justify-content: space-between;
  gap: 15px;
  color: #7b8580;
  font-size: 9px;
  font-weight: 700;
}


/* =========================================================
   DARK MODE
   ========================================================= */

body.dark-mode {
  --cream: #111916;
  --cream-2: #18211d;
  --white: #17211d;
  --ink: #eef4f0;
  --muted: #a5b2ab;
  --line: #2c3933;

  background:
    radial-gradient(circle at 10% 0%, rgba(21,145,107,.12), transparent 30%),
    #101613;
}

body.dark-mode .card,
body.dark-mode .race-meta-card,
body.dark-mode .ranking-item,
body.dark-mode .admin-horse-row,
body.dark-mode .status-setting {
  background: #17211d;
  border-color: #2c3933;
}

body.dark-mode .horse-option label {
  background: #141d19;
  border-color: #2c3933;
}

body.dark-mode .horse-option input:checked + label {
  background: #17382c;
}

body.dark-mode .outline-button,
body.dark-mode .admin-horse-row button,
body.dark-mode .login-form input,
body.dark-mode .settings-form input,
body.dark-mode .winner-card select {
  background: #141d19;
  color: var(--ink);
  border-color: #34433c;
}

body.dark-mode .admin-tip {
  background: #17241e;
  border-color: #34433c;
}

body.dark-mode .site-footer {
  color: #7f8e86;
}


/* =========================================================
   RESPONSIVE
   ========================================================= */

@media (max-width: 900px) {

  .hero-grid {
    grid-template-columns: 1fr;
    min-height: 520px;
  }

  .hero-copy {
    padding: 45px 32px;
  }

  .horse-illustration {
    inset: auto 0 0;
    height: 235px;
  }

  .illustrated-horse {
    right: 80px;
    bottom: 20px;
    font-size: 130px;
  }

  .sun {
    top: 20px;
    right: 50px;
    width: 70px;
    height: 70px;
  }

  .vote-layout,
  .results-layout,
  .admin-grid {
    grid-template-columns: 1fr;
  }

  .admin-side-column {
    grid-template-columns: 1fr 1fr;
  }

  .admin-tip {
    grid-column: 1 / -1;
  }

  .results-summary {
    grid-template-columns: 1fr auto 1fr;
  }

  .summary-live {
    grid-column: 1 / -1;
    justify-content: center;
    padding-top: 10px;
    border-top: 1px solid var(--line);
  }

}

@media (max-width: 650px) {

  .header-inner,
  .main-nav,
  main,
  .site-footer {
    width: min(100% - 22px, 1180px);
  }

  .header-inner {
    min-height: 68px;
  }

  .brand-mark {
    width: 40px;
    height: 40px;
    font-size: 23px;
  }

  .brand-text strong {
    font-size: 14px;
  }

  .brand-text small {
    font-size: 8px;
  }

  .free-badge {
    display: none;
  }

  .main-nav {
    overflow-x: auto;
  }

  .nav-link {
    padding: 11px 15px 13px;
    font-size: 11px;
  }

  main {
    padding: 25px 0 55px;
  }

  .hero-grid {
    min-height: 520px;
    border-radius: 22px;
  }

  .hero-copy {
    padding: 34px 23px;
  }

  .hero-copy h1 {
    font-size: 42px;
  }

  .hero-description {
    font-size: 12px;
  }

  .horse-illustration {
    height: 210px;
  }

  .illustrated-horse {
    right: 45px;
    bottom: 10px;
    font-size: 112px;
  }

  .finish-flag {
    right: -10px;
    width: 70px;
    height: 70px;
  }

  .race-meta-card {
    padding: 16px;
    align-items: flex-start;
    flex-direction: column;
  }

  .race-meta-main {
    width: 100%;
  }

  .race-number {
    padding-right: 12px;
  }

  .race-meta-card h2 {
    font-size: 15px;
  }

  .race-meta-card p {
    font-size: 9px;
  }

  .selection-card,
  .ranking-card,
  .admin-card {
    padding: 21px;
  }

  .section-heading {
    align-items: flex-start;
  }

  .section-heading h2 {
    font-size: 18px;
  }

  .horse-list {
    grid-template-columns: 1fr;
  }

  .horse-option label {
    min-height: 75px;
  }

  .page-heading h1 {
    font-size: 34px;
  }

  .results-summary {
    grid-template-columns: 1fr 1fr;
    gap: 14px;
  }

  .summary-divider {
    display: none;
  }

  .summary-live {
    grid-column: 1 / -1;
  }

  .ranking-item {
    grid-template-columns: 35px 1fr auto;
    padding: 11px;
  }

  .admin-login {
    margin: 10px auto;
    padding: 28px 20px;
  }

  .admin-topbar {
    align-items: center;
  }

  .admin-topbar h1 {
    font-size: 30px;
  }

  .admin-side-column {
    grid-template-columns: 1fr;
  }

  .admin-tip {
    grid-column: auto;
  }

  .site-footer {
    flex-direction: column;
    text-align: center;
  }

  .desktop-only {
    display: none;
  }

}

@media (max-width: 390px) {

  .hero-copy h1 {
    font-size: 37px;
  }

  .hero-notes {
    gap: 5px;
  }

  .hero-notes span {
    padding: 6px 8px;
    font-size: 9px;
  }

  .horse-option label {
    padding: 12px;
  }

  .horse-name {
    font-size: 13px;
  }

}
